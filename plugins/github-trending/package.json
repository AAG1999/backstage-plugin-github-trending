{
  "name": "@aag1999/plugin-github-trending",
  "version": "0.1.0",
  "description": "GitHub Trending home ticker for Backstage",
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "github-trending",
    "pluginPackages": [
      "@aag1999/plugin-github-trending",
      "@aag1999/plugin-github-trending-backend",
      "@aag1999/plugin-github-trending-common"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AAG1999/backstage-plugin-github-trending",
    "directory": "plugins/github-trending"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@aag1999/plugin-github-trending-common": "workspace:^",
    "@backstage/core-components": "^0.18.13",
    "@backstage/core-plugin-api": "^1.12.9",
    "@backstage/frontend-plugin-api": "^0.18.0",
    "@backstage/plugin-home-react": "^0.1.41",
    "@material-ui/core": "^4.12.2",
    "@material-ui/icons": "^4.11.3",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.3.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.5",
    "@backstage/dev-utils": "^1.1.0",
    "@backstage/test-utils": "^1.7.21",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "react": "^18.0.2",
    "react-dom": "^18.0.2",
    "react-router-dom": "^6.30.2"
  }
}
